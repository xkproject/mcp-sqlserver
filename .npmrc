# Security hardening — pnpm v11 supply-chain mitigations
#
# Reference: pnpm v11 default policies for protection against npm supply-chain
# attacks (e.g. TanStack 2026-05 incident with malicious postinstall scripts).
#
# 1. ignore-scripts: do NOT auto-execute postinstall/preinstall of any package.
#    The build scripts allowed to run are explicitly listed in pnpm-workspace.yaml
#    under `allowBuilds:` (currently only esbuild needs its postinstall to fetch
#    the platform-specific binary).
#
# 2. minimum-release-age: do not install package versions younger than 24h.
#    This gives the community time to detect and revoke compromised releases
#    before they reach this repo.
#
# 3. block-exotic-subdeps: transitive dependencies cannot pull from non-registry
#    sources (git URLs, tarballs). Only direct top-level deps may use exotic
#    sources, which makes review explicit.
#
# 4. auto-install-peers: required by pnpm to resolve TypeScript peer
#    dependencies transparently.

ignore-scripts=true
minimum-release-age=1440
block-exotic-subdeps=true
auto-install-peers=true
